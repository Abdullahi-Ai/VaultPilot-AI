# VaultPilot AI — Environment Configuration Template for UGREEN NAS
# Copy this file to .env before starting the container stack via UGOS Container Station.

# ==============================================================================
# 1. Storage & NAS Integration Modes
# ==============================================================================
# Permitted STORAGE_MODE values:
#   - physical_nas : Strict Mode C. Requires mounted volume at UGREEN_NAS_ROOT.
#   - emulated_nas : Mode B. Offline demo sandbox with synthetic NGO data.
#   - local_dev    : Mode A. Local developer fixtures in ./storage/dev_fixtures.
STORAGE_MODE=physical_nas

# Backward-compatibility mode flag (real or emulated)
UGREEN_NAS_MODE=real

# Path to the authorized financial documents shared folder on the NAS volume.
# Default for UGREEN UGOS shared folders is on /volume1/.
UGREEN_NAS_ROOT=/volume1/NGO_Projects

# ==============================================================================
# 2. Database & Persistent Application Storage
# ==============================================================================
# SQLite database path inside the persistent vaultpilot_data Docker volume.
DATABASE_URL=sqlite:////vaultpilot_data/vaultpilot.db

# ==============================================================================
# 3. Security, Scalability & Resource Bounds
# ==============================================================================
# Maximum number of document files scanned in a single investigation scope.
MAX_DISCOVERY_FILES=500

# Maximum directory traversal depth relative to investigation scope path.
MAX_DISCOVERY_DEPTH=5

# Maximum document file size (in bytes) allowed for pre-extraction processing (25 MB default).
MAX_FILE_SIZE_BYTES=26214400

# Secret key for HMAC-SHA256 audit trail attestation & tamper-evidence.
# CRITICAL: Replace with a cryptographically secure random string before production deployment!
AUDIT_SECRET_KEY=change-this-to-a-secure-random-token-for-production-nas

# ==============================================================================
# 4. Networking & Port Bindings
# ==============================================================================
# Host port mapping for the FastAPI backend API service.
BACKEND_PORT=8000

# Host port mapping for the React frontend web interface.
FRONTEND_PORT=5173
